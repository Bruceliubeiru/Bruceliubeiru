.tab-page {
  min-height: 100vh;
  padding: 30rpx 24rpx 150rpx;
  background: #f7f4f1;
  color: #171c22;
}

.tab-hero,
.profile-card,
.surface {
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e8dfdb;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(68, 43, 37, 0.05);
}

.tab-hero {
  text-align: left;
}

.profile-card,
.section-head,
.list-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-head {
  align-items: flex-start;
}

.section-head .section-title {
  flex: 1;
  min-width: 0;
}

.picker-field {
  min-height: 112rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #edf0f2;
  border-radius: 12rpx;
  background: #fbfcfd;
}

.tab-input {
  width: 100%;
  height: 82rpx;
  margin-top: 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid #edf0f2;
  border-radius: 12rpx;
  background: #fbfcfd;
  color: #171c22;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 82rpx;
}

.tab-textarea {
  width: 100%;
  min-height: 150rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #d7dde2;
  border-radius: 12rpx;
  background: #fbfcfd;
  color: #171c22;
  font-size: 27rpx;
  line-height: 1.5;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 84rpx;
  margin-top: 16rpx;
  border-radius: 10rpx;
  background: #a9342c;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}

.primary-button[disabled] {
  background: #c9a5a0;
  color: #ffffff;
}

.metric-grid.mini {
  grid-template-columns: repeat(4, 1fr);
  margin: 16rpx 0 0;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  flex: 0 0 70rpx;
  border-radius: 14rpx;
  background: #b83d32;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
}

.eyebrow,
.title,
.subtitle,
.section-title,
.metric-value,
.metric-label,
.item-title,
.item-meta,
.entry-title,
.empty,
.error,
.status {
  display: block;
}

.eyebrow {
  color: #a33b32;
  font-size: 20rpx;
  font-weight: 900;
}

.title {
  margin-top: 8rpx;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.2;
}

.title.small {
  margin-top: 0;
  font-size: 35rpx;
}

.subtitle {
  margin-top: 10rpx;
  color: #776d68;
  font-size: 26rpx;
  line-height: 1.55;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.metric {
  min-width: 0;
  padding: 18rpx 6rpx;
  border: 1rpx solid #e8dfdb;
  border-radius: 12rpx;
  background: #ffffff;
  text-align: center;
}

.metric-value {
  color: #a9342c;
  font-size: 36rpx;
  font-weight: 900;
}

.metric-label {
  margin-top: 6rpx;
  color: #7a838d;
  font-size: 20rpx;
  font-weight: 800;
}

.section-title {
  font-size: 31rpx;
  font-weight: 900;
}

.ghost-button,
.pill-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  min-width: 132rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d7dde2;
  border-radius: 10rpx;
  background: #ffffff;
  color: #3e4852;
  font-size: 24rpx;
  font-weight: 800;
}

.pill-button {
  min-width: 104rpx;
  border-color: #e6c8c3;
  color: #a9342c;
}

.list-card {
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #edf0f2;
  border-radius: 12rpx;
  background: #fbfcfd;
}

.item-title {
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.item-meta {
  margin-top: 8rpx;
  color: #77818b;
  font-size: 24rpx;
  line-height: 1.45;
}

.status {
  flex: 0 0 auto;
  color: #a9342c;
  font-size: 23rpx;
  font-weight: 900;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.entry {
  min-height: 120rpx;
  padding: 18rpx;
  border: 1rpx solid #edf0f2;
  border-radius: 12rpx;
  background: #fbfcfd;
}

.entry-title {
  font-size: 27rpx;
  font-weight: 900;
}

.action-stack {
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  gap: 10rpx;
}

.empty,
.error {
  margin-top: 18rpx;
  color: #8a939c;
  font-size: 25rpx;
}

.error {
  color: #bd3f2d;
}
