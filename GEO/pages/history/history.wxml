<view class="page">
  <view class="app-header">
    <view class="header-action back" bindtap="goBack">返回</view>
    <view class="header-copy">
      <text class="title">历史任务</text>
      <text class="subtitle">分析、版本与复测记录</text>
    </view>
    <view class="header-action refresh {{loading ? 'disabled' : ''}}" bindtap="loadHistory">刷新</view>
  </view>

  <view class="stats">
    <view class="stat"><text class="stat-value">{{tasks.length}}</text><text class="stat-label">任务</text></view>
    <view class="stat"><text class="stat-value">{{versions.length}}</text><text class="stat-label">版本</text></view>
    <view class="stat"><text class="stat-value">{{injections.length}}</text><text class="stat-label">交付</text></view>
    <view class="stat"><text class="stat-value">{{retestGroups.length}}</text><text class="stat-label">复测</text></view>
    <view class="stat"><text class="stat-value">{{articles.length}}</text><text class="stat-label">文章</text></view>
  </view>

  <view wx:if="{{selectedTaskId}}" class="filter-bar">
    <text class="filter-copy">筛选任务：{{selectedTaskId}}</text>
    <button bindtap="clearFilter">清除</button>
  </view>

  <view class="tabs">
    <button class="tab {{activeTab === 'tasks' ? 'active' : ''}}" data-tab="tasks" bindtap="switchTab">任务</button>
    <button class="tab {{activeTab === 'versions' ? 'active' : ''}}" data-tab="versions" bindtap="switchTab">版本</button>
    <button class="tab {{activeTab === 'injections' ? 'active' : ''}}" data-tab="injections" bindtap="switchTab">交付</button>
    <button class="tab {{activeTab === 'publications' ? 'active' : ''}}" data-tab="publications" bindtap="switchTab">发布</button>
    <button class="tab {{activeTab === 'retests' ? 'active' : ''}}" data-tab="retests" bindtap="switchTab">复测</button>
    <button class="tab {{activeTab === 'feedback' ? 'active' : ''}}" data-tab="feedback" bindtap="switchTab">反馈</button>
    <button class="tab {{activeTab === 'visibility' ? 'active' : ''}}" data-tab="visibility" bindtap="switchTab">AI 可见度</button>
    <button class="tab {{activeTab === 'experiments' ? 'active' : ''}}" data-tab="experiments" bindtap="switchTab">实验</button>
    <button class="tab {{activeTab === 'attributions' ? 'active' : ''}}" data-tab="attributions" bindtap="switchTab">归因</button>
    <button class="tab {{activeTab === 'reports' ? 'active' : ''}}" data-tab="reports" bindtap="switchTab">报告</button>
    <button class="tab {{activeTab === 'articles' ? 'active' : ''}}" data-tab="articles" bindtap="switchTab">文章</button>
  </view>

  <text wx:if="{{error}}" class="error">{{error}}</text>

  <view wx:if="{{activeTab === 'tasks'}}" class="list">
    <view class="card task-card" wx:for="{{tasks}}" wx:key="task_id" wx:for-item="task" data-task-id="{{task.task_id}}" bindtap="selectTask">
      <view class="card-top">
        <view class="card-copy">
          <text class="card-title">{{task.title || task.url}}</text>
          <text class="url">{{task.url}}</text>
        </view>
        <text class="status">{{task.status}}</text>
      </view>
      <view class="card-footer">
        <text>{{task.task_id}}</text>
        <text class="resume-link" catchtap="resumeTask" data-task-id="{{task.task_id}}">继续任务 ›</text>
      </view>
    </view>
    <text wx:if="{{!tasks.length && !loading}}" class="empty">暂无任务记录</text>
  </view>

  <view wx:if="{{activeTab === 'injections'}}" class="list">
    <view class="card" wx:for="{{displayInjections}}" wx:key="injection_id" wx:for-item="injection">
      <view class="card-top">
        <view class="card-copy">
          <text class="card-title">{{injection.version_id}}</text>
          <text class="url">{{injection.injection_id}}</text>
        </view>
        <text class="status {{injection.status}}">{{injection.status}}</text>
      </view>
      <view class="version-grid">
        <view><text class="meta-label">目标</text><text class="meta-value">{{injection.target}}</text></view>
        <view><text class="meta-label">完成时间</text><text class="meta-value date">{{injection.completed_at}}</text></view>
        <view><text class="meta-label">交付结果</text><text class="meta-value">{{injection.response_summary}}</text></view>
      </view>
    </view>
    <text wx:if="{{!displayInjections.length && !loading}}" class="empty">暂无交付记录</text>
  </view>

  <view wx:if="{{activeTab === 'publications'}}" class="list">
    <view class="card" wx:for="{{displayPublications}}" wx:key="publication_id" wx:for-item="publication">
      <view class="card-top">
        <view class="card-copy">
          <text class="card-title">{{publication.publication_id}}</text>
          <text class="url">{{publication.target_id}}</text>
        </view>
        <text class="status {{publication.status}}">{{publication.status}}</text>
      </view>
      <view class="version-grid">
        <view><text class="meta-label">确认</text><text class="meta-value">{{publication.confirmed_by || '-'}}</text></view>
        <view><text class="meta-label">上线校验</text><text class="meta-value">{{publication.live_status || '-'}}</text></view>
        <view><text class="meta-label">结果</text><text class="meta-value">{{publication.response_summary || '-'}}</text></view>
      </view>
      <view class="card-footer"><text>{{publication.preview.target_name || publication.target_id}}</text><text class="resume-link" catchtap="resumeTask" data-task-id="{{publication.task_id}}">继续任务 ›</text></view>
    </view>
    <text wx:if="{{!displayPublications.length && !loading}}" class="empty">暂无发布记录</text>
  </view>

  <view wx:if="{{activeTab === 'versions'}}" class="list">
    <view class="card" wx:for="{{displayVersions}}" wx:key="version_id" wx:for-item="version">
      <view class="card-top">
        <view class="card-copy">
          <text class="card-title">{{version.version_id}}</text>
          <text class="url">{{version.url}}</text>
        </view>
        <text class="status {{version.status}}">{{version.status}}</text>
      </view>
      <view class="version-grid">
        <view><text class="meta-label">模块</text><text class="meta-value">{{version.modules.length}}</text></view>
        <view><text class="meta-label">编辑者</text><text class="meta-value">{{version.editor}}</text></view>
        <view><text class="meta-label">更新时间</text><text class="meta-value date">{{version.updated_at}}</text></view>
      </view>
      <button class="copy" data-index="{{index}}" bindtap="copyPayload">复制注入 JSON</button>
    </view>
    <text wx:if="{{!displayVersions.length && !loading}}" class="empty">暂无版本记录</text>
  </view>

  <view wx:if="{{activeTab === 'retests'}}" class="list">
    <view class="card" wx:for="{{displayRetestGroups}}" wx:key="task_id" wx:for-item="group">
      <text class="card-title">{{group.task_id}}</text>
      <view class="retest" wx:for="{{group.items}}" wx:key="created_at" wx:for-item="item">
        <view class="score-row">
          <text class="score-before">{{item.previous_score}}</text>
          <text class="score-arrow">→</text>
          <text class="score-after">{{item.current_score}}</text>
          <text class="delta {{item.score_delta > 0 ? 'positive' : ''}}">{{item.score_delta > 0 ? '+' : ''}}{{item.score_delta}}</text>
        </view>
        <view class="card-footer"><text>{{item.status}}</text><text class="resume-link" catchtap="resumeTask" data-task-id="{{group.task_id}}">继续任务 ›</text></view>
        <view class="card-footer"><text>{{item.created_at}}</text><text>{{item.effect_details.verdict || '-'}}</text></view>
      </view>
    </view>
    <text wx:if="{{!displayRetestGroups.length && !loading}}" class="empty">暂无复测记录</text>
  </view>

  <view wx:if="{{activeTab === 'feedback'}}" class="list">
    <view class="card" wx:for="{{displayFeedbackEntries}}" wx:key="feedback_id" wx:for-item="entry">
      <view class="card-top">
        <view class="card-copy">
          <text class="card-title">{{entry.verdict}}</text>
          <text class="url">{{entry.publication_id || entry.version_id || entry.task_id}}</text>
        </view>
        <text class="status">{{entry.source}}</text>
      </view>
      <view class="version-grid">
        <view><text class="meta-label">提交人</text><text class="meta-value">{{entry.actor}}</text></view>
        <view><text class="meta-label">任务</text><text class="meta-value">{{entry.task_id}}</text></view>
        <view><text class="meta-label">时间</text><text class="meta-value date">{{entry.created_at}}</text></view>
      </view>
      <text class="url">{{entry.notes}}</text>
      <view class="card-footer"><text>{{entry.feedback_id}}</text><text class="resume-link" catchtap="resumeTask" data-task-id="{{entry.task_id}}">继续任务 ›</text></view>
    </view>
    <text wx:if="{{!displayFeedbackEntries.length && !loading}}" class="empty">暂无人工反馈</text>
  </view>

  <view wx:if="{{activeTab === 'visibility'}}" class="list">
    <view class="card" wx:for="{{displayMentionChecks}}" wx:key="check_id" wx:for-item="check">
      <view class="card-top">
        <view class="card-copy">
          <text class="card-title">{{check.engine}}</text>
          <text class="url">{{check.query_id}}</text>
        </view>
        <text class="status {{check.brand_mentioned ? 'completed' : 'failed'}}">{{check.brand_mentioned ? '已提及' : '未提及'}}</text>
      </view>
      <view class="version-grid">
        <view><text class="meta-label">推荐位置</text><text class="meta-value">{{check.mention_position || '-'}}</text></view>
        <view><text class="meta-label">引用来源</text><text class="meta-value">{{check.source_type || '-'}}</text></view>
        <view><text class="meta-label">检查时间</text><text class="meta-value date">{{check.checked_at}}</text></view>
      </view>
      <text class="url">{{check.answer_excerpt || check.notes || '暂无答案摘录'}}</text>
    </view>
    <text wx:if="{{!displayMentionChecks.length && !loading}}" class="empty">暂无 AI 平台可见度记录</text>
  </view>

  <view wx:if="{{activeTab === 'experiments'}}" class="list">
    <view class="card" wx:for="{{displayExperiments}}" wx:key="experiment_id" wx:for-item="item">
      <view class="card-top">
        <view class="card-copy">
          <text class="card-title">{{item.name}}</text>
          <text class="url">{{item.primary_metric}}</text>
        </view>
        <text class="status">{{item.status}}</text>
      </view>
      <text class="url">{{item.hypothesis}}</text>
    </view>
    <text wx:if="{{!displayExperiments.length && !loading}}" class="empty">暂无内容实验</text>
  </view>

  <view wx:if="{{activeTab === 'attributions'}}" class="list">
    <view class="card" wx:for="{{displayAttributions}}" wx:key="attribution_id" wx:for-item="item">
      <view class="card-top">
        <view class="card-copy">
          <text class="card-title">{{item.source_name}}</text>
          <text class="url">{{item.source_type}}</text>
        </view>
        <text class="status">{{item.status}}</text>
      </view>
      <view class="version-grid">
        <view><text class="meta-label">任务</text><text class="meta-value">{{item.task_id}}</text></view>
        <view><text class="meta-label">阶段</text><text class="meta-value">{{item.lead_stage}}</text></view>
        <view><text class="meta-label">金额</text><text class="meta-value">{{item.attributed_revenue}}</text></view>
      </view>
    </view>
    <text wx:if="{{!displayAttributions.length && !loading}}" class="empty">暂无线索归因</text>
  </view>

  <view wx:if="{{activeTab === 'reports'}}" class="list">
    <view class="card" wx:for="{{displayReports}}" wx:key="report_id" wx:for-item="item">
      <view class="card-top">
        <view class="card-copy">
          <text class="card-title">{{item.period_label}}</text>
          <text class="url">{{item.report_id}}</text>
        </view>
        <text class="status">{{item.status}}</text>
      </view>
      <text class="url">{{item.summary}}</text>
    </view>
    <text wx:if="{{!displayReports.length && !loading}}" class="empty">暂无效果报告</text>
  </view>

  <view wx:if="{{activeTab === 'articles'}}" class="list">
    <view class="card" wx:for="{{displayArticles}}" wx:key="article_id" wx:for-item="item">
      <view class="card-top">
        <view class="card-copy">
          <text class="card-title">{{item.title}}</text>
          <text class="url">{{item.public_url || item.feishu_url || item.markdown_path || item.article_id}}</text>
        </view>
        <text class="status {{item.index_status}}">{{item.index_status}}</text>
      </view>
      <view class="version-grid">
        <view><text class="meta-label">任务</text><text class="meta-value">{{item.task_id}}</text></view>
        <view><text class="meta-label">创建时间</text><text class="meta-value date">{{item.created_at}}</text></view>
        <view>
          <text class="meta-label">交付位置</text>
          <text wx:if="{{item.public_url}}" class="meta-value">公开页面</text>
          <text wx:elif="{{item.feishu_url}}" class="meta-value">飞书文档</text>
          <text wx:else class="meta-value">本地草稿</text>
        </view>
      </view>
      <button class="copy" data-index="{{index}}" bindtap="copyArticle">复制文章链接</button>
    </view>
    <text wx:if="{{!displayArticles.length && !loading}}" class="empty">暂无 GEO 文章，去分析页用飞书文章 Agent 创建。</text>
  </view>
</view>
