<view class="tab-page">
  <view class="tab-hero">
    <text class="eyebrow">MONITORING OPS</text>
    <text class="title">AI 可见度运营台</text>
    <text class="subtitle">把套餐、接入、信源动作、内容实验、归因和收录推进收束在同一页，确保每一步可执行、可追踪、可恢复。</text>
  </view>

  <view class="metric-grid monitor">
    <view class="metric">
      <text class="metric-value">{{stats.mentionRate}}%</text>
      <text class="metric-label">Mention 率</text>
    </view>
    <view class="metric">
      <text class="metric-value">{{stats.citationRate}}%</text>
      <text class="metric-label">Citation 率</text>
    </view>
    <view class="metric">
      <text class="metric-value">{{stats.experiments}}</text>
      <text class="metric-label">实验数</text>
    </view>
    <view class="metric">
      <text class="metric-value">{{stats.revenue}}</text>
      <text class="metric-label">归因金额</text>
    </view>
  </view>

  <text wx:if="{{error}}" class="error">{{error}}</text>

  <view class="surface">
    <view class="section-head">
      <text class="section-title">当前项目</text>
      <button class="ghost-button" bindtap="loadData">刷新</button>
    </view>
    <picker wx:if="{{tasks.length}}" mode="selector" range="{{tasks}}" range-key="title" value="{{selectedTaskIndex}}" bindchange="changeTask">
      <view class="picker-field">
        <text class="item-meta">监控对象</text>
        <text class="item-title">{{selectedTask.title || selectedTask.url}}</text>
      </view>
    </picker>
    <text wx:if="{{!tasks.length && !loading}}" class="empty">暂无任务，请先在分析页创建项目</text>
  </view>

  <view class="surface" wx:if="{{selectedProject}}">
    <view class="section-head">
      <text class="section-title">项目与套餐</text>
      <button class="ghost-button" data-task-id="{{selectedTask.task_id}}" bindtap="resumeTask">进入主流程</button>
    </view>
    <view class="info-grid">
      <view class="info-card">
        <text class="item-meta">客户 / 品牌</text>
        <text class="item-title">{{selectedProject.client_name || '未填写客户'}} / {{selectedProject.brand_name || '未填写品牌'}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">下一步</text>
        <text class="item-title">{{selectedProject.next_action}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">动作进度</text>
        <text class="item-title">{{selectedProject.action_progress.done}} / {{selectedProject.action_progress.total}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">商业就绪</text>
        <text class="item-title">{{selectedProject.commercial_readiness.ready ? 'ready' : 'gaps'}}</text>
      </view>
    </view>
    <picker wx:if="{{servicePackages.length}}" mode="selector" range="{{servicePackages}}" range-key="name" value="{{packageIndex}}" bindchange="onPackageChange">
      <view class="picker-field compact">
        <text class="item-meta">套餐绑定</text>
        <text class="item-title">{{servicePackages[packageIndex].name}} · {{servicePackages[packageIndex].tier}} · ¥{{servicePackages[packageIndex].price_cny}}</text>
      </view>
    </picker>
    <view class="action-stack top-gap" wx:if="{{servicePackages.length}}">
      <button class="primary-button small" loading="{{assigningPackage}}" disabled="{{assigningPackage}}" bindtap="assignPackage">保存套餐绑定</button>
      <button wx:if="{{selectedProject.recommended_package}}" class="ghost-button" bindtap="applyRecommendedPackage">切到推荐套餐</button>
    </view>
    <view wx:if="{{selectedProject.recommended_package}}" class="checklist-box top-gap">
      <text class="item-title">推荐套餐</text>
      <text class="item-meta">{{selectedProject.recommended_package.name}} · {{selectedProject.recommended_package.tier}} · ¥{{selectedProject.recommended_package.price_cny}} · {{selectedProject.recommended_package.delivery_days}} 天</text>
      <view class="status-stack compact">
        <view class="status-note" wx:for="{{selectedProject.recommended_package.reason}}" wx:key="*this" wx:for-item="item">{{item}}</view>
      </view>
      <button class="pill-button top-gap" data-package-id="{{selectedProject.recommended_package.package_id}}" loading="{{assigningPackage}}" disabled="{{assigningPackage}}" bindtap="assignPackage">直接绑定推荐套餐</button>
    </view>
    <view class="status-stack" wx:if="{{selectedProject.commercial_readiness && !selectedProject.commercial_readiness.ready}}">
      <view class="status-note">商业准备度 {{selectedProject.commercial_readiness.completion_percent}}%</view>
      <view class="status-note" wx:for="{{selectedProject.commercial_readiness.missing}}" wx:key="*this" wx:for-item="item">待补齐：{{item}}</view>
    </view>
    <view wx:if="{{selectedProject.package_sla}}" class="checklist-box top-gap">
      <text class="item-title">套餐 SLA</text>
      <text class="item-meta">状态：{{selectedProject.package_sla.status}} · 进度 {{selectedProject.package_sla.completion_percent}}%</text>
      <text class="item-meta">截止：{{selectedProject.package_sla.due_at || '未设置'}} · 剩余 {{selectedProject.package_sla.days_remaining !== null ? selectedProject.package_sla.days_remaining : '-'}} 天</text>
      <text wx:if="{{selectedProject.package_sla.overdue_days}}" class="item-meta">已逾期 {{selectedProject.package_sla.overdue_days}} 天</text>
    </view>
    <view wx:if="{{selectedProject.package_delivery && selectedProject.package_delivery.length}}" class="status-stack">
      <view class="list-card mini-card" wx:for="{{selectedProject.package_delivery}}" wx:key="feature_key" wx:for-item="item">
        <view>
          <text class="item-title">{{item.feature}}</text>
          <text class="item-meta">{{item.status}} · {{item.source === 'manual' ? '人工回填' : '系统推断'}}</text>
          <text wx:if="{{item.notes}}" class="item-meta">{{item.notes}}</text>
          <text wx:if="{{item.next_hint}}" class="item-meta">{{item.next_hint}}</text>
        </view>
        <view class="action-stack column">
          <button class="pill-button" loading="{{savingSection === ('package-' + item.feature_key)}}" data-feature-key="{{item.feature_key}}" data-status="in_progress" bindtap="updatePackageDelivery">进行中</button>
          <button class="pill-button" loading="{{savingSection === ('package-' + item.feature_key)}}" data-feature-key="{{item.feature_key}}" data-status="done" bindtap="updatePackageDelivery">完成</button>
          <button class="pill-button" loading="{{savingSection === ('package-' + item.feature_key)}}" data-feature-key="{{item.feature_key}}" data-status="blocked" bindtap="updatePackageDelivery">阻塞</button>
        </view>
      </view>
    </view>
    <view class="divider"></view>
    <text class="section-subtitle">新增服务套餐</text>
    <input class="tab-input" value="{{forms.servicePackage.name}}" placeholder="套餐名称，例如 GEO 多平台标准包" data-path="forms.servicePackage.name" bindinput="onFieldInput" />
    <view class="picker-row">
      <picker mode="selector" range="{{servicePackageTierOptions}}" data-path="forms.servicePackage.tier" data-options="servicePackageTierOptions" bindchange="onPickerChange">
        <view class="picker-chip">层级：{{forms.servicePackage.tier}}</view>
      </picker>
      <picker mode="selector" range="{{servicePackageStatusOptions}}" data-path="forms.servicePackage.status" data-options="servicePackageStatusOptions" bindchange="onPickerChange">
        <view class="picker-chip">状态：{{forms.servicePackage.status}}</view>
      </picker>
    </view>
    <input class="tab-input" value="{{forms.servicePackage.price_cny}}" placeholder="价格（CNY）" type="digit" data-path="forms.servicePackage.price_cny" bindinput="onFieldInput" />
    <input class="tab-input" value="{{forms.servicePackage.delivery_days}}" placeholder="交付天数" type="number" data-path="forms.servicePackage.delivery_days" bindinput="onFieldInput" />
    <textarea class="tab-textarea" value="{{forms.servicePackage.platforms_text}}" placeholder="覆盖平台，一行一个，例如 ChatGPT / Perplexity / Claude" data-path="forms.servicePackage.platforms_text" bindinput="onFieldInput"></textarea>
    <textarea class="tab-textarea" value="{{forms.servicePackage.features_text}}" placeholder="交付能力，一行一个，例如 多平台监测接入 / 内容实验 / 线索归因 / 报告导出" data-path="forms.servicePackage.features_text" bindinput="onFieldInput"></textarea>
    <button class="primary-button small" loading="{{savingSection === 'service-package'}}" disabled="{{savingSection === 'service-package'}}" bindtap="saveServicePackageDraft">创建服务套餐</button>
  </view>

  <view class="surface" wx:if="{{selectedProject}}">
    <view class="section-head">
      <text class="section-title">周报与采样结果</text>
      <button class="ghost-button" loading="{{generatingReport}}" disabled="{{generatingReport}}" bindtap="buildReport">生成报告</button>
    </view>
    <input class="tab-input" value="{{reportPeriod}}" placeholder="报告周期，例如 近 30 天 / 2026-W28" bindinput="onReportPeriodInput" />
    <view class="mini-grid" wx:if="{{monitoring}}">
      <view class="mini-metric">
        <text class="metric-value">{{monitoring.mention_rate || 0}}%</text>
        <text class="metric-label">提及率</text>
      </view>
      <view class="mini-metric">
        <text class="metric-value">{{monitoring.citation_rate || 0}}%</text>
        <text class="metric-label">官网引用</text>
      </view>
      <view class="mini-metric">
        <text class="metric-value">{{monitoring.connector_status.connected || 0}}</text>
        <text class="metric-label">已连通接入</text>
      </view>
      <view class="mini-metric">
        <text class="metric-value">{{monitoring.sampling.confidence_level || 'none'}}</text>
        <text class="metric-label">采样可信度</text>
      </view>
    </view>
    <text wx:if="{{monitoring && monitoring.sampling.warning}}" class="status-note solo">{{monitoring.sampling.warning}}</text>
    <text wx:if="{{lastReportExport}}" class="status-note solo">{{lastReportExport}}</text>
    <view class="info-grid" wx:if="{{selectedProject.reporting_summary}}">
      <view class="info-card">
        <text class="item-meta">报告总数</text>
        <text class="item-title">{{selectedProject.reporting_summary.count}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">最新周期</text>
        <text class="item-title">{{selectedProject.reporting_summary.latest_period || '未生成'}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">已确认</text>
        <text class="item-title">{{selectedProject.reporting_summary.confirmed}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">最近导出</text>
        <text class="item-title">{{selectedProject.reporting_summary.latest_export_format || '未导出'}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">已分享</text>
        <text class="item-title">{{selectedProject.reporting_summary.shared || 0}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">最近渠道</text>
        <text class="item-title">{{selectedProject.reporting_summary.latest_share_channel || '未分享'}}</text>
      </view>
    </view>
    <view class="picker-row">
      <picker mode="selector" range="{{reportShareChannelOptions}}" data-path="forms.reportShare.share_channel" data-options="reportShareChannelOptions" bindchange="onPickerChange">
        <view class="picker-chip">分发渠道：{{forms.reportShare.share_channel}}</view>
      </picker>
    </view>
    <textarea class="tab-textarea" value="{{forms.reportShare.notes}}" placeholder="记录报告发送渠道、客户回执和后续动作" data-path="forms.reportShare.notes" bindinput="onFieldInput"></textarea>
    <view class="list-card" wx:for="{{reports}}" wx:key="report_id" wx:for-item="report">
      <view>
        <text class="item-title">{{report.period_label}}</text>
        <text class="item-meta">{{report.summary}}</text>
        <text wx:if="{{report.findings && report.findings.length}}" class="item-meta">发现：{{report.findings[0]}}</text>
        <text wx:if="{{report.share_status}}" class="item-meta">分发：{{report.share_status}} · {{report.share_channel || '未填渠道'}}</text>
      </view>
      <view class="action-stack column">
        <button wx:if="{{report.status !== 'confirmed'}}" class="pill-button" loading="{{confirmingReportId === report.report_id}}" disabled="{{confirmingReportId}}" data-report-id="{{report.report_id}}" bindtap="confirmReport">确认</button>
        <text wx:else class="status">✓ 已确认</text>
        <button wx:if="{{report.status === 'confirmed' && report.share_status !== 'shared'}}" class="pill-button" loading="{{savingSection === ('report-share-' + report.report_id)}}" data-report-id="{{report.report_id}}" bindtap="shareReport">标记已分发</button>
        <button class="pill-button" loading="{{reportExportingId === report.report_id}}" disabled="{{reportExportingId}}" data-report-id="{{report.report_id}}" bindtap="exportReport">导出</button>
      </view>
    </view>
    <view wx:if="{{recentReportExports.length}}" class="status-stack">
      <view class="status-note" wx:for="{{recentReportExports}}" wx:key="export_id" wx:for-item="item">
        {{item.format}} · {{item.status}} · {{item.external_url || item.filepath || item.note || '无路径'}} · {{item.created_at}}
      </view>
    </view>
  </view>

  <view class="surface" wx:if="{{selectedProject && monitoring}}">
    <view class="section-head">
      <text class="section-title">多平台监测接入</text>
      <text class="section-tag">{{monitoring.connector_status.count || 0}} 个</text>
    </view>
    <view class="info-grid" wx:if="{{monitoring.connector_plan}}">
      <view class="info-card">
        <text class="item-meta">目标平台</text>
        <text class="item-title">{{monitoring.connector_plan.target_platforms}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">已连通</text>
        <text class="item-title">{{monitoring.connector_plan.connected}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">待补齐</text>
        <text class="item-title">{{monitoring.connector_plan.missing}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">下一平台</text>
        <text class="item-title">{{monitoring.connector_plan.next_platform || '已完成'}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">Fresh / Stale</text>
        <text class="item-title">{{monitoring.connector_status.fresh || 0}} / {{monitoring.connector_status.stale || 0}}</text>
      </view>
      <view class="info-card">
        <text class="item-meta">待补凭证</text>
        <text class="item-title">{{monitoring.connector_status.missing_credentials || 0}}</text>
      </view>
    </view>
    <view wx:if="{{monitoring.connector_blueprints && monitoring.connector_blueprints.length}}" class="status-stack">
      <view class="list-card mini-card" wx:for="{{monitoring.connector_blueprints}}" wx:key="platform" wx:for-item="item">
        <view>
          <text class="item-title">{{item.platform}} · {{item.provider_name}}</text>
          <text class="item-meta">{{item.connector_type}} · {{item.verification_method}} · {{item.status}}</text>
          <text class="item-meta">{{item.audit_requirement}}</text>
          <text wx:if="{{item.next_check_at}}" class="item-meta">下次复核：{{item.next_check_at}}</text>
          <text wx:if="{{item.recovery_hint}}" class="item-meta">恢复：{{item.recovery_hint}}</text>
        </view>
        <button wx:if="{{item.status !== 'connected'}}" class="pill-button" data-platform="{{item.platform}}" bindtap="useConnectorBlueprint">套用模板</button>
      </view>
    </view>
    <input class="tab-input" value="{{forms.connector.provider_name}}" placeholder="接入名称，例如 OpenAI Responses API" data-path="forms.connector.provider_name" bindinput="onFieldInput" />
    <view class="picker-row">
      <picker mode="selector" range="{{connectorPlatformOptions}}" data-path="forms.connector.platform" data-options="connectorPlatformOptions" bindchange="onPickerChange">
        <view class="picker-chip">平台：{{forms.connector.platform}}</view>
      </picker>
      <picker mode="selector" range="{{connectorTypeOptions}}" data-path="forms.connector.connector_type" data-options="connectorTypeOptions" bindchange="onPickerChange">
        <view class="picker-chip">方式：{{forms.connector.connector_type}}</view>
      </picker>
      <picker mode="selector" range="{{connectorStatusOptions}}" data-path="forms.connector.status" data-options="connectorStatusOptions" bindchange="onPickerChange">
        <view class="picker-chip">状态：{{forms.connector.status}}</view>
      </picker>
    </view>
    <picker mode="selector" range="{{verificationMethodOptions}}" data-path="forms.connector.verification_method" data-options="verificationMethodOptions" bindchange="onPickerChange">
      <view class="picker-field compact">
        <text class="item-meta">校验方式</text>
        <text class="item-title">{{forms.connector.verification_method}}</text>
      </view>
    </picker>
    <input class="tab-input" value="{{forms.connector.credential_env_var}}" placeholder="凭证环境变量，例如 OPENAI_API_KEY" data-path="forms.connector.credential_env_var" bindinput="onFieldInput" />
    <input class="tab-input" value="{{forms.connector.evidence_url}}" placeholder="可审计凭证或截图 URL（可选）" data-path="forms.connector.evidence_url" bindinput="onFieldInput" />
    <input class="tab-input" value="{{forms.connector.owner}}" placeholder="负责人，例如 ops@example.com" data-path="forms.connector.owner" bindinput="onFieldInput" />
    <input class="tab-input" value="{{forms.connector.next_check_at}}" placeholder="下次复核时间（ISO，例如 2026-07-24T09:00:00+08:00）" data-path="forms.connector.next_check_at" bindinput="onFieldInput" />
    <input class="tab-input" value="{{forms.connector.last_error}}" placeholder="失败原因或恢复备注（回填时可写）" data-path="forms.connector.last_error" bindinput="onFieldInput" />
    <textarea class="tab-textarea" value="{{forms.connector.recovery_hint}}" placeholder="恢复建议或人工检查路径" data-path="forms.connector.recovery_hint" bindinput="onFieldInput"></textarea>
    <textarea class="tab-textarea" value="{{forms.connector.notes}}" placeholder="记录接入限制、人工校验方法、失败恢复说明" data-path="forms.connector.notes" bindinput="onFieldInput"></textarea>
    <view class="action-stack top-gap">
      <button class="primary-button small wide-action" loading="{{savingSection === 'connector'}}" disabled="{{savingSection === 'connector'}}" bindtap="saveConnector">{{editingConnectorId ? '回填接入状态' : '保存监测接入'}}</button>
      <button wx:if="{{editingConnectorId}}" class="ghost-button" bindtap="clearConnectorDraft">取消回填</button>
    </view>
    <view wx:if="{{editingConnectorId}}" class="checklist-box top-gap">
      <text class="item-title">接入执行日志</text>
      <view class="picker-row">
        <picker mode="selector" range="{{connectorStatusOptions}}" data-path="forms.connectorRun.status" data-options="connectorStatusOptions" bindchange="onPickerChange">
          <view class="picker-chip">结果：{{forms.connectorRun.status}}</view>
        </picker>
      </view>
      <input class="tab-input" value="{{forms.connectorRun.evidence_url}}" placeholder="本次校验的证据 URL" data-path="forms.connectorRun.evidence_url" bindinput="onFieldInput" />
      <input class="tab-input" value="{{forms.connectorRun.next_check_at}}" placeholder="下次复核时间（ISO，可选）" data-path="forms.connectorRun.next_check_at" bindinput="onFieldInput" />
      <input class="tab-input" value="{{forms.connectorRun.last_error}}" placeholder="失败或恢复说明" data-path="forms.connectorRun.last_error" bindinput="onFieldInput" />
      <textarea class="tab-textarea" value="{{forms.connectorRun.notes}}" placeholder="记录执行步骤、人工确认人、恢复动作" data-path="forms.connectorRun.notes" bindinput="onFieldInput"></textarea>
      <button class="primary-button small" loading="{{savingSection === 'connector-run'}}" disabled="{{savingSection === 'connector-run'}}" bindtap="logConnectorRun">保存执行记录</button>
    </view>
    <view class="list-card" wx:for="{{monitoring.connectors}}" wx:key="connector_id" wx:for-item="item">
      <view>
        <text class="item-title">{{item.platform}} · {{item.provider_name}}</text>
        <text class="item-meta">{{item.connector_type}} · {{item.status}} · {{item.verification_method}}</text>
        <text class="item-meta">新鲜度：{{item.freshness}} {{item.age_days !== null ? ('· ' + item.age_days + ' 天') : ''}}</text>
        <text wx:if="{{item.credential_env_var}}" class="item-meta">凭证：{{item.credential_env_var}} · {{item.credential_configured ? '已配置' : '待配置'}}</text>
        <text wx:if="{{item.owner}}" class="item-meta">负责人：{{item.owner}}</text>
        <text wx:if="{{item.next_check_at}}" class="item-meta">下次复核：{{item.next_check_at}} {{item.next_check_due ? '· 已到期' : ''}}</text>
        <text wx:if="{{item.evidence_url}}" class="item-meta">证据：{{item.evidence_url}}</text>
        <text wx:if="{{item.recovery_hint}}" class="item-meta">恢复：{{item.recovery_hint}}</text>
        <text wx:if="{{item.last_error}}" class="item-meta">错误：{{item.last_error}}</text>
        <text wx:if="{{item.latest_run}}" class="item-meta">最近执行：{{item.latest_run.status}} · {{item.latest_run.created_at}}</text>
      </view>
      <view class="action-stack column">
        <button class="pill-button" data-connector-id="{{item.connector_id}}" bindtap="fillConnectorForm">回填</button>
        <button class="pill-button" data-connector-id="{{item.connector_id}}" data-status="connected" bindtap="markConnectorStatus">连通</button>
        <button class="pill-button" data-connector-id="{{item.connector_id}}" data-status="failed" bindtap="markConnectorStatus">失败</button>
      </view>
    </view>
    <view wx:if="{{recentConnectorRuns.length}}" class="checklist-box top-gap">
      <text class="item-title">最近接入执行轨迹</text>
      <view class="list-card mini-card" wx:for="{{recentConnectorRuns}}" wx:key="run_id" wx:for-item="item">
        <view>
          <text class="item-title">{{item.status}} · {{item.connector_id}}</text>
          <text class="item-meta">{{item.notes || item.last_error || '无备注'}}</text>
          <text wx:if="{{item.evidence_url}}" class="item-meta">{{item.evidence_url}}</text>
        </view>
        <text class="status">{{item.created_at}}</text>
      </view>
    </view>
  </view>

  <view class="surface" wx:if="{{selectedProject && monitoring}}">
    <view class="section-head">
      <text class="section-title">答案解析与信源落库</text>
      <text class="section-tag">{{monitoring.source_observations.length || 0}} 条</text>
    </view>
    <picker wx:if="{{monitoring.queries.length}}" mode="selector" range="{{monitoring.queries}}" range-key="query_text" value="{{sourceQueryIndex}}" bindchange="onSourceQueryChange">
      <view class="picker-field">
        <text class="item-meta">监测 Query</text>
        <text class="item-title">{{selectedSourceQueryLabel || '请选择 Query'}}</text>
      </view>
    </picker>
    <picker mode="selector" range="{{sourceParsePlatformOptions}}" data-path="forms.sourceParse.platform" data-options="sourceParsePlatformOptions" bindchange="onPickerChange">
      <view class="picker-field compact">
        <text class="item-meta">回答平台</text>
        <text class="item-title">{{forms.sourceParse.platform}}</text>
      </view>
    </picker>
    <textarea class="tab-textarea tall" value="{{forms.sourceParse.answer_text}}" placeholder="粘贴 AI 回答全文，系统会解析 Mention、Citation、Competitor 和来源" data-path="forms.sourceParse.answer_text" bindinput="onFieldInput"></textarea>
