<view class="page">
  <view class="app-header">
    <view class="brand-block">
      <view class="brand-mark">G</view>
      <view>
        <text class="brand-name">GEO 工作台</text>
        <text class="brand-meta">AI Search Content OS</text>
      </view>
    </view>
    <button class="header-action" bindtap="goHistory">历史任务</button>
  </view>

  <view wx:if="{{!hasAnalyzed}}" class="start-view">
    <view class="intro-band">
      <text class="intro-kicker">GEO GROWTH SERVICE</text>
      <text class="intro-title">让品牌进入 AI 的推荐答案</text>
      <text class="intro-subtitle">提交网址，完成诊断、内容生成、人工审核、页面注入和多平台效果追踪。</text>
      <view class="intro-flow">
        <view class="flow-item active">
          <text class="flow-no">01</text>
          <text class="flow-name">诊断</text>
        </view>
        <view class="flow-line"></view>
        <view class="flow-item">
          <text class="flow-no">02</text>
          <text class="flow-name">生成</text>
        </view>
        <view class="flow-line"></view>
        <view class="flow-item">
          <text class="flow-no">03</text>
          <text class="flow-name">审核</text>
        </view>
        <view class="flow-line"></view>
        <view class="flow-item">
          <text class="flow-no">04</text>
          <text class="flow-name">注入</text>
        </view>
      </view>
    </view>

    <view class="service-menu">
      <view class="service-menu-item"><text class="service-icon">诊</text><text>URL 诊断</text></view>
      <view class="service-menu-item"><text class="service-icon">策</text><text>信源策略</text></view>
      <view class="service-menu-item"><text class="service-icon">注</text><text>页面注入</text></view>
      <view class="service-menu-item"><text class="service-icon">追</text><text>效果追踪</text></view>
    </view>

    <view class="surface analysis-form">
      <view class="segmented">
        <button class="segment {{mode === 'url' ? 'active' : ''}}" data-mode="url" bindtap="switchMode">URL 分析</button>
        <button class="segment {{mode === 'content' ? 'active' : ''}}" data-mode="content" bindtap="switchMode">文案分析</button>
      </view>

      <block wx:if="{{mode === 'url'}}">
        <view class="form-section first">
          <text class="form-section-title">客户项目</text>
          <view class="client-grid">
            <input class="business-input" value="{{clientName}}" placeholder="客户 / 公司名称" bindinput="onClientNameInput" />
            <input class="business-input" value="{{brandName}}" placeholder="推广品牌名称" bindinput="onBrandNameInput" />
          </view>
          <input class="business-input goal-input" value="{{businessGoal}}" placeholder="本次业务目标" bindinput="onBusinessGoalInput" />
        </view>
        <view class="field-block">
          <text class="field-label">目标 URL</text>
          <textarea class="main-input" value="{{url}}" placeholder="https://example.com/page" bindinput="onUrlInput" />
          <text class="field-hint">支持多个 URL 换行输入，单次最多 5 个</text>
        </view>

        <view class="form-section">
          <text class="form-section-title">目标 AI 平台</text>
          <view class="engine-grid">
            <button class="engine-option {{selectedEngineMap[item.value] ? 'selected' : ''}}" wx:for="{{engineOptions}}" wx:key="value" data-engine="{{item.value}}" bindtap="toggleEngine">
              <text class="engine-name">{{item.label}}</text>
              <text class="engine-note">{{item.note}}</text>
            </button>
          </view>
        </view>

        <view class="form-section">
          <text class="form-section-title">分析范围</text>
          <view class="config-grid">
            <picker mode="selector" range="{{pageTypeOptions}}" range-key="label" value="{{pageTypeIndex}}" bindchange="changePageType">
              <view class="config-field">
                <text class="config-label">页面类型</text>
                <text class="config-value">{{pageTypeOptions[pageTypeIndex].label}}</text>
              </view>
            </picker>
            <picker mode="selector" range="{{languageOptions}}" range-key="label" value="{{languageIndex}}" bindchange="changeLanguage">
              <view class="config-field">
                <text class="config-label">语言</text>
                <text class="config-value">{{languageOptions[languageIndex].label}}</text>
              </view>
            </picker>
            <picker mode="selector" range="{{marketOptions}}" range-key="label" value="{{marketIndex}}" bindchange="changeMarket">
              <view class="config-field">
                <text class="config-label">市场</text>
                <text class="config-value">{{marketOptions[marketIndex].label}}</text>
              </view>
            </picker>
          </view>
        </view>

        <view class="form-section">
          <text class="form-section-title">生成内容</text>
          <view class="option-grid">
            <button class="option-toggle {{generateFaq ? 'on' : ''}}" data-key="generateFaq" bindtap="toggleOption">
              <text class="option-check">{{generateFaq ? '✓' : ''}}</text>
              <text>FAQ</text>
            </button>
            <button class="option-toggle {{generateSchema ? 'on' : ''}}" data-key="generateSchema" bindtap="toggleOption">
              <text class="option-check">{{generateSchema ? '✓' : ''}}</text>
              <text>Schema</text>
            </button>
            <button class="option-toggle {{generateConversionTips ? 'on' : ''}}" data-key="generateConversionTips" bindtap="toggleOption">
              <text class="option-check">{{generateConversionTips ? '✓' : ''}}</text>
              <text>转化建议</text>
            </button>
            <button class="option-toggle {{useAi ? 'on' : ''}}" data-key="useAi" bindtap="toggleOption">
              <text class="option-check">{{useAi ? '✓' : ''}}</text>
              <text>AI 分析</text>
            </button>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="field-block">
          <text class="field-label">页面文案</text>
          <textarea class="main-input content-input" value="{{content}}" placeholder="粘贴页面正文、产品介绍或 FAQ 文案" bindinput="onContentInput" />
        </view>
      </block>

      <button class="primary-action" loading="{{loading}}" disabled="{{loading}}" bindtap="runAudit">
        {{loading ? '正在分析' : '开始分析'}}
      </button>
      <text wx:if="{{error}}" class="error">{{error}}</text>
    </view>

    <view class="quick-grid">
      <button class="quick-action" bindtap="goHistory">
        <text class="quick-icon">H</text>
        <text class="quick-title">历史任务</text>
        <text class="quick-meta">任务、版本与复测</text>
      </button>
      <view class="quick-action static">
        <text class="quick-icon">交</text>
        <text class="quick-title">标准交付</text>
        <text class="quick-meta">诊断、注入、平台复测</text>
      </view>
    </view>
  </view>

  <view wx:else class="result-view">
    <view class="result-toolbar">
      <button class="back-action" bindtap="resetAudit">新建分析</button>
      <view class="toolbar-actions">
        <button class="toolbar-button" bindtap="copyJson">复制 JSON</button>
        <button class="toolbar-button" loading="{{exporting}}" disabled="{{exporting}}" bindtap="exportJsonFile">导出</button>
      </view>
    </view>

    <view class="score-hero">
      <view class="score-main">
        <text class="score-label">GEO SCORE</text>
        <view class="score-line">
          <text class="score-number">{{result.geo_score}}</text>
          <text class="score-total">/100</text>
        </view>
        <text class="score-title">{{result.title}}</text>
        <text class="score-url">{{result.url}}</text>
      </view>
      <view class="score-change">
        <text class="change-label">预计提升</text>
        <text class="change-value">+{{workflow.score_delta || 12}}</text>
        <text class="change-target">目标 {{workflow.predicted_score || result.geo_score + 12}}</text>
      </view>
    </view>

    <scroll-view class="workflow-rail" scroll-x>
      <view class="workflow-row">
        <view class="workflow-step {{stage.status}}" wx:for="{{workflow.stages}}" wx:key="key" wx:for-item="stage">
          <view class="workflow-dot"></view>
          <text class="workflow-name">{{stage.name}}</text>
          <text class="workflow-status">{{stage.status}}</text>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{monitoring}}" class="surface visibility-surface">
      <view class="section-head">
        <view>
          <text class="section-eyebrow">AI VISIBILITY</text>
          <text class="section-title">多平台推荐追踪</text>
        </view>
        <text class="section-tag">{{monitoring.active_query_count || 0}} 个监测问题</text>
      </view>
      <view class="visibility-grid">
        <view class="visibility-metric"><text class="visibility-value">{{monitoring.mention_rate || 0}}%</text><text class="visibility-label">品牌提及率</text></view>
        <view class="visibility-metric"><text class="visibility-value">{{monitoring.citation_rate || 0}}%</text><text class="visibility-label">官网引用率</text></view>
        <view class="visibility-metric"><text class="visibility-value">{{monitoring.average_position || '-'}}</text><text class="visibility-label">平均推荐位</text></view>
        <view class="visibility-metric"><text class="visibility-value">{{monitoring.sampling.confidence_level || 'none'}}</text><text class="visibility-label">采样可信度</text></view>
      </view>
      <view wx:if="{{monitoring.sampling.warning}}" class="status-note">{{monitoring.sampling.warning}} 当前 {{monitoring.sampling.sample_count || 0}}/{{monitoring.sampling.sample_target || 0}} 样本。</view>
      <view class="engine-strip">
        <view class="engine-pill" wx:for="{{project.target_engines}}" wx:key="*this">{{item}}</view>
      </view>
      <view wx:if="{{monitoring.source_map.recommendations.length}}" class="monitor-actions">
        <view class="issue-row" wx:for="{{monitoring.source_map.recommendations}}" wx:key="title" wx:for-item="recommendation">
          <view class="issue-mark">→</view><text>{{recommendation.title}}：{{recommendation.action}}</text>
        </view>
      </view>
      <view wx:else class="status-note">下一步：每周在目标 AI 平台记录品牌是否出现、推荐位置和引用来源，建立可量化增长基线。</view>
    </view>

    <view wx:if="{{result.task_id && result.is_url_task !== false}}" class="surface compact-surface">
      <view class="section-head">
        <view>
          <text class="section-eyebrow">EXPERIMENTS</text>
          <text class="section-title">内容实验</text>
        </view>
        <text class="section-tag">{{experiments.length}} 个</text>
      </view>
      <input class="business-input" value="{{experimentName}}" placeholder="实验名称" bindinput="onExperimentNameInput" />
      <textarea class="module-body-input" value="{{experimentHypothesis}}" placeholder="实验假设：例如 FAQ + 对比表能提升 Perplexity 提及率" bindinput="onExperimentHypothesisInput" />
      <input class="business-input" value="{{experimentVariantA}}" placeholder="A 方案" bindinput="onExperimentVariantAInput" />
      <input class="business-input" value="{{experimentVariantB}}" placeholder="B 方案" bindinput="onExperimentVariantBInput" />
      <view class="review-bar">
        <button loading="{{savingExperiment}}" disabled="{{savingExperiment}}" bindtap="createExperiment">创建实验</button>
      </view>
      <view wx:for="{{experiments}}" wx:key="experiment_id" wx:for-item="experiment" class="status-note">
        {{experiment.name}} · {{experiment.status}} · {{experiment.primary_metric}}
        <button size="mini" data-experiment-id="{{experiment.experiment_id}}" bindtap="markExperimentWon">确认赢面</button>
      </view>
    </view>

    <view wx:if="{{result.task_id && result.is_url_task !== false}}" class="surface compact-surface">
      <view class="section-head">
        <view>
          <text class="section-eyebrow">ATTRIBUTION</text>
          <text class="section-title">线索归因</text>
        </view>
        <text class="section-tag">{{attributions.length}} 条</text>
      </view>
      <input class="business-input" value="{{attributionSourceName}}" placeholder="来源名称，例如 ChatGPT 推荐 / 行业媒体" bindinput="onAttributionSourceNameInput" />
      <input class="business-input" value="{{attributionRevenue}}" placeholder="归因金额（可选）" type="number" bindinput="onAttributionRevenueInput" />
      <input class="business-input" value="{{attributionEvidenceUrl}}" placeholder="证据链接（可选）" bindinput="onAttributionEvidenceUrlInput" />
      <view class="review-bar">
        <button loading="{{savingAttribution}}" disabled="{{savingAttribution}}" bindtap="saveLeadAttribution">登记线索</button>
      </view>
      <view wx:for="{{attributions}}" wx:key="attribution_id" wx:for-item="item" class="status-note">
        {{item.source_name}} · {{item.status}} · {{item.attributed_revenue || 0}}
      </view>
    </view>

    <view wx:if="{{result.task_id && result.is_url_task !== false}}" class="surface compact-surface">
      <view class="section-head">
        <view>
          <text class="section-eyebrow">REPORTING</text>
          <text class="section-title">效果报告</text>
        </view>
        <text class="section-tag">{{reports.length}} 期</text>
      </view>
      <input class="business-input" value="{{reportPeriod}}" placeholder="报告周期" bindinput="onReportPeriodInput" />
      <view class="review-bar">
        <button loading="{{generatingReport}}" disabled="{{generatingReport}}" bindtap="buildEffectReport">生成报告</button>
      </view>
      <view wx:for="{{reports}}" wx:key="report_id" wx:for-item="report" class="status-note">
        {{report.period_label}} · {{report.status}} · 提及率 {{report.metrics.mention_rate || 0}}%
        <button wx:if="{{report.status !== 'confirmed'}}" size="mini" data-report-id="{{report.report_id}}" bindtap="confirmLatestReport">确认</button>
      </view>
    </view>

    <view wx:if="{{taskList.length > 1}}" class="surface compact-surface">
      <view class="section-head">
        <text class="section-title">批量任务</text>
        <text class="section-tag">{{taskList.length}} 个 URL</text>
      </view>
      <view class="task-row" wx:for="{{taskList}}" wx:key="task_id" wx:for-item="task">
        <view class="task-copy">
          <text class="task-title">{{task.title}}</text>
          <text class="task-url">{{task.url}}</text>
        </view>
        <text class="task-score">{{task.score}}</text>
      </view>
    </view>

    <view class="surface">
      <view class="section-head">
        <view>
          <text class="section-eyebrow">DIAGNOSTIC</text>
          <text class="section-title">诊断拆解</text>
        </view>
        <text class="section-tag">{{dimensions.length}} 项</text>
      </view>
      <view class="metric-grid">
        <view class="metric-item" wx:for="{{dimensions}}" wx:key="key">
          <view class="metric-top">
            <text class="metric-name">{{item.label}}</text>
            <text class="metric-value">{{item.value}}/{{item.max}}</text>
          </view>
          <view class="metric-track"><view class="metric-bar" style="width: {{item.percent}}%;"></view></view>
        </view>
      </view>
    </view>

    <view class="surface execution-surface">
      <view class="section-head">
        <view>
          <text class="section-eyebrow">ACTION PLAN</text>
          <text class="section-title">执行工作流</text>
        </view>
        <text class="section-tag">{{stepPanel.phase}}</text>
      </view>
      <view class="step-switcher">
        <button class="step-switch {{activeStep === item.key ? 'active' : ''}}" wx:for="{{nextSteps}}" wx:key="key" data-step="{{item.key}}" bindtap="switchStep">
          <text class="step-index">{{index + 1}}</text>
          <text class="step-label">{{item.title}}</text>
        </button>
      </view>
      <view class="active-step-panel">
        <text class="active-step-title">{{stepPanel.title}}</text>
        <text class="active-step-detail">{{stepPanel.detail}}</text>
        <view class="check-list">
          <view class="check-row" wx:for="{{stepPanel.items}}" wx:key="*this" wx:for-item="todo">
            <view class="check-mark">✓</view>
            <text class="check-copy">{{todo}}</text>
          </view>
        </view>
        <text class="step-note">{{stepPanel.note}}</text>
        <button class="primary-action compact" loading="{{improving && activeStep === 'produce'}}" disabled="{{improving}}" bindtap="runStepAction">
          {{improving && activeStep === 'produce' ? '正在生成' : stepPanel.action}}
        </button>
      </view>
    </view>

    <view class="surface package-surface">
      <view class="section-head">
        <view>
          <text class="section-eyebrow">CONTENT PACKAGE</text>
          <text class="section-title">内容与注入</text>
        </view>
        <view class="mini-actions">
          <button bindtap="copyMarkdown">MD</button>
          <button bindtap="copyJson">JSON</button>
        </view>
      </view>

      <scroll-view class="result-tabs-scroll" scroll-x>
        <view class="result-tabs">
          <button class="result-tab {{activeTab === tab.value ? 'active' : ''}}" wx:for="{{resultTabs}}" wx:key="value" wx:for-item="tab" data-tab="{{tab.value}}" bindtap="switchTab">{{tab.label}}</button>
        </view>
      </scroll-view>

      <view wx:if="{{activeTab === 'summary'}}" class="tab-panel">
        <view class="summary-grid">
          <view class="summary-item">
            <text class="summary-label">页面主题</text>
            <text class="summary-value">{{result.page_summary.theme}}</text>
          </view>
          <view class="summary-item half">
            <text class="summary-label">页面类型</text>
            <text class="summary-value">{{result.page_summary.product_type}}</text>
          </view>
          <view class="summary-item half">
            <text class="summary-label">市场 / 语言</text>
            <text class="summary-value">{{result.page_summary.market}} · {{result.page_summary.language}}</text>
          </view>
        </view>
        <text class="content-subtitle">目标用户</text>
        <view class="chip-wrap">
          <view class="chip" wx:for="{{result.page_summary.target_user}}" wx:key="*this" wx:for-item="user">{{user}}</view>
        </view>
        <text class="content-subtitle">内容缺口</text>
        <view class="issue-row" wx:for="{{result.content_gaps}}" wx:key="*this" wx:for-item="gap">
          <view class="issue-mark">!</view><text>{{gap}}</text>
        </view>
      </view>

      <view wx:if="{{activeTab === 'assets'}}" class="tab-panel">
        <text class="content-subtitle first">核心实体</text>
        <view class="chip-wrap"><view class="chip green" wx:for="{{result.geo_assets.entities}}" wx:key="*this" wx:for-item="entity">{{entity}}</view></view>
        <text class="content-subtitle">关键词</text>
        <view class="chip-wrap"><view class="chip" wx:for="{{result.geo_assets.keywords}}" wx:key="*this" wx:for-item="keyword">{{keyword}}</view></view>
        <text class="content-subtitle">搜索意图</text>
        <view class="chip-wrap"><view class="chip amber" wx:for="{{result.geo_assets.search_intents}}" wx:key="*this" wx:for-item="intent">{{intent}}</view></view>
      </view>

      <view wx:if="{{activeTab === 'modules'}}" class="tab-panel">
        <view wx:if="{{project}}" class="status-note">
          当前阶段：{{project.current_stage || result.status}} · 下一步：{{project.next_action}} · 负责人：{{project.owner || '待分配'}} · 目标 {{project.target_score || 80}} 分
        </view>
        <view wx:if="{{project && project.todos && project.todos.length}}" class="issue-list">
          <view class="issue-row" wx:for="{{project.todos}}" wx:key="*this" wx:for-item="todo">
            <view class="issue-mark">•</view><text>{{todo}}</text>
          </view>
        </view>
        <view class="module-card" wx:for="{{result.injection_modules}}" wx:key="module_type" wx:for-item="module">
          <view class="module-head">
            <text class="module-type">{{module.module_type}}</text>
            <text class="module-status">{{module.review_status || module.priority}}</text>
          </view>
          <input class="module-title-input" value="{{module.title}}" data-index="{{index}}" bindinput="updateModuleTitle" />
          <textarea class="module-body-input" value="{{module.body}}" data-index="{{index}}" bindinput="updateModuleBody" />
          <view class="module-meta-row">
            <text>{{module.target_position}}</text>
            <text wx:if="{{module.injection_field}}">{{module.injection_field}}</text>
          </view>
        </view>
        <view wx:if="{{result.task_id && result.is_url_task !== false}}" class="review-bar">
          <button loading="{{savingVersion}}" disabled="{{savingVersion}}" bindtap="saveDraftVersion">保存版本</button>
          <button class="approve" loading="{{reviewing}}" disabled="{{reviewing}}" bindtap="approveVersion">审核通过</button>
        </view>
        <view wx:if="{{result.task_id && result.is_url_task !== false && cmsTargets.length}}" class="delivery-config">
          <text class="delivery-title">CMS 发布目标</text>
          <picker mode="selector" range="{{cmsTargets}}" range-key="name" value="{{cmsTargetIndex}}" bindchange="changeCmsTarget">
            <view class="config-field">
              <text class="config-label">发布目标</text>
              <text class="config-value">{{cmsTargets[cmsTargetIndex].name}} · {{cmsTargets[cmsTargetIndex].environment}}</text>
            </view>
          </picker>
          <view class="review-bar">
            <button loading="{{publishing}}" disabled="{{publishing}}" bindtap="createCmsPreview">创建发布预览</button>
            <button loading="{{publishing}}" disabled="{{publishing}}" bindtap="retryCmsPublish">重试失败发布</button>
          </view>
          <input class="webhook-input" value="{{publishConfirmation}}" placeholder="输入 PUBLISH 确认正式发布" bindinput="onPublishConfirmationInput" />
          <view class="review-bar">
            <button class="approve" loading="{{publishing}}" disabled="{{publishing}}" bindtap="confirmCmsPublish">确认发布</button>
            <button loading="{{verifyingPublication}}" disabled="{{verifyingPublication}}" bindtap="verifyCmsPublication">上线校验</button>
            <button bindtap="scheduleCmsVerification">安排自动校验</button>
          </view>
        </view>
        <view wx:if="{{publications.length}}" class="delivery-config">
          <text class="delivery-title">发布记录</text>
          <picker mode="selector" range="{{publications}}" range-key="publication_id" value="{{selectedPublicationIndex}}" bindchange="changeSelectedPublication">
            <view class="config-field">
              <text class="config-label">当前记录</text>
              <text class="config-value">{{selectedPublication.publication_id}} · {{selectedPublication.status}}</text>
            </view>
          </picker>
          <view wx:if="{{selectedPublication}}" class="status-stack">
            <view class="status-note">目标 {{selectedPublication.preview.target_name || selectedPublication.target_id}} · {{selectedPublication.preview.environment || '-'}}</view>
            <view class="status-note">模块 {{selectedPublication.preview.module_count || 0}} 个 · 上线校验 {{selectedPublication.live_status || 'pending'}}</view>
            <view wx:if="{{selectedPublication.response_summary}}" class="status-note">发布结果：{{selectedPublication.response_summary}}</view>
            <view wx:if="{{selectedPublication.live_summary}}" class="status-note">校验命中 {{selectedPublication.live_summary.matched_terms.length}} 项，缺失 {{selectedPublication.live_summary.missing_terms.length}} 项</view>
          </view>
          <input class="webhook-input" value="{{verifyTerms}}" placeholder="可选：输入校验词，逗号或换行分隔" bindinput="onVerifyTermsInput" />
        </view>
        <view wx:if="{{result.task_id && result.is_url_task !== false}}" class="delivery-config">
          <text class="delivery-title">交付目标</text>
          <view class="delivery-switch">
            <button class="{{deliveryTarget === 'json_file' ? 'active' : ''}}" data-target="json_file" bindtap="setDeliveryTarget">JSON 文件</button>
            <button class="{{deliveryTarget === 'webhook' ? 'active' : ''}}" data-target="webhook" bindtap="setDeliveryTarget">CMS Webhook</button>
          </view>
          <input wx:if="{{deliveryTarget === 'webhook'}}" class="webhook-input" value="{{webhookUrl}}" placeholder="https://cms.example.com/geo-hook" bindinput="onWebhookInput" />
        </view>
        <view wx:if="{{result.task_id && result.is_url_task !== false}}" class="review-bar">
          <button loading="{{injecting}}" disabled="{{injecting}}" bindtap="runInjection">交付注入</button>
          <button bindtap="scheduleRetest">安排复测</button>
          <button loading="{{retesting}}" disabled="{{retesting}}" bindtap="runRetest">立即复测</button>
        </view>
        <view wx:else class="status-note">内容分析模式仅提供诊断与草稿预览；请使用 URL 分析进入版本、审核、交付与复测闭环。</view>
        <view wx:if="{{version}}" class="status-note">版本 {{version.version_id}} · {{version.status}}</view>
        <view wx:if="{{version && version.quality_report}}" class="status-note">质量门禁 {{version.quality_report.status}} · {{version.quality_report.score}} 分 · {{version.quality_report.issues.length}} 项需关注 · 知识引用覆盖 {{version.quality_report.citation_coverage.percent}}%</view>
        <view wx:if="{{injection}}" class="status-note">交付 {{injection.injection_id}} · {{injection.status}} · {{injection.target}}</view>
        <view wx:if="{{retest}}" class="status-note">复测 {{retest.previous_score}} → {{retest.current_score}} · {{retest.score_delta}} 分</view>
        <view wx:if="{{selectedPublication}}" class="status-note">发布 {{selectedPublication.publication_id}} · {{selectedPublication.status}} · 上线校验 {{selectedPublication.live_status || 'pending'}}</view>
        <view wx:if="{{result.task_id && result.is_url_task !== false}}" class="delivery-config">
          <text class="delivery-title">人工反馈学习</text>
          <view class="delivery-switch">
            <button class="{{feedbackVerdict === 'accepted' ? 'active' : ''}}" data-verdict="accepted" bindtap="setFeedbackVerdict">采纳</button>
            <button class="{{feedbackVerdict === 'needs_edit' ? 'active' : ''}}" data-verdict="needs_edit" bindtap="setFeedbackVerdict">待修改</button>
            <button class="{{feedbackVerdict === 'rejected' ? 'active' : ''}}" data-verdict="rejected" bindtap="setFeedbackVerdict">驳回</button>
          </view>
          <textarea class="module-body-input" value="{{feedbackNotes}}" placeholder="记录人工确认结果、CMS 异常、页面上线差异、后续修正建议" bindinput="onFeedbackNotesInput" />
          <view class="review-bar">
            <button loading="{{savingFeedback}}" disabled="{{savingFeedback}}" bindtap="submitFeedback">提交反馈</button>
          </view>
          <view wx:if="{{feedbackEntries.length}}" class="feedback-history">
            <view class="status-note" wx:for="{{feedbackEntries}}" wx:key="feedback_id" wx:for-item="entry">
              {{entry.verdict}} · {{entry.actor}} · {{entry.created_at}}
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{activeTab === 'schema'}}" class="tab-panel">
        <view class="schema-row" wx:for="{{result.schema_suggestions}}" wx:key="schema_type" wx:for-item="schema">
          <view><text class="schema-title">{{schema.schema_type}}</text><text class="schema-meta">结构化数据建议</text></view>
          <text class="schema-status">{{schema.validation_status}}</text>
        </view>
      </view>

      <view wx:if="{{activeTab === 'conversion'}}" class="tab-panel">
        <view class="conversion-row" wx:for="{{result.conversion_tips}}" wx:key="*this" wx:for-item="tip">
          <text class="conversion-index">{{index + 1}}</text><text>{{tip}}</text>
        </view>
      </view>
    </view>

    <view class="surface preview-surface">
      <view class="section-head"><text class="section-title">抓取内容预览</text></view>
      <text class="preview-copy">{{result.content_preview}}</text>
    </view>
  </view>
</view>
