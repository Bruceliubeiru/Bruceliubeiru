.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 138rpx;
  background: #f7f4f1;
  color: #171c22;
}

.app-header,
.result-toolbar,
.brand-block,
.toolbar-actions,
.section-head,
.metric-top,
.module-head,
.module-meta-row,
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.app-header {
  min-height: 82rpx;
  margin-bottom: 22rpx;
}

.brand-block {
  gap: 14rpx;
  justify-content: flex-start;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 12rpx;
  background: #b83d32;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
}

.brand-name,
.brand-meta {
  display: block;
}

.brand-name {
  font-size: 31rpx;
  font-weight: 900;
}

.brand-meta {
  margin-top: 4rpx;
  color: #7a838d;
  font-size: 21rpx;
  font-weight: 700;
}

.header-action,
.back-action,
.toolbar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d7dde2;
  border-radius: 10rpx;
  background: #ffffff;
  color: #3e4852;
  font-size: 24rpx;
  font-weight: 800;
}

.intro-band {
  padding: 44rpx 8rpx 34rpx;
  border-bottom: 1rpx solid #eadfda;
  text-align: center;
}

.intro-kicker,
.section-eyebrow,
.score-label {
  display: block;
  color: #a33b32;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.intro-title {
  display: block;
  margin-top: 8rpx;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.2;
}

.intro-subtitle {
  display: block;
  max-width: 650rpx;
  margin: 16rpx auto 0;
  color: #776d68;
  font-size: 26rpx;
  line-height: 1.6;
}

.intro-flow {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.flow-item {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  align-items: center;
  color: #9099a2;
}

.flow-item.active {
  color: #a33b32;
}

.flow-no {
  font-size: 20rpx;
  font-weight: 900;
}

.flow-name {
  font-size: 24rpx;
  font-weight: 800;
}

.flow-line {
  flex: 1;
  height: 2rpx;
  margin: 0 12rpx;
  background: #dce1e5;
}

.surface {
  margin-top: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #e8dfdb;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(68, 43, 37, 0.05);
}

.analysis-form {
  margin-top: 0;
  overflow: hidden;
}

.segmented {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  width: 100%;
  padding: 8rpx;
  border-radius: 14rpx;
  background: #edf0f2;
}

.segment {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 72rpx;
  border-radius: 11rpx;
  background: transparent;
  color: #6d7781;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 72rpx;
  text-align: center;
}

.segment.active {
  background: #ffffff;
  color: #171c22;
  box-shadow: 0 3rpx 10rpx rgba(20, 29, 38, 0.08);
}

.field-block,
.form-section {
  margin-top: 26rpx;
}

.field-label,
.form-section-title,
.content-subtitle {
  display: block;
  color: #343d46;
  font-size: 28rpx;
  font-weight: 900;
}

.main-input {
  width: 100%;
  height: 172rpx;
  margin-top: 14rpx;
  padding: 22rpx;
  border: 1rpx solid #cfd6dc;
  border-radius: 10rpx;
  background: #fbfcfd;
  color: #171c22;
  font-size: 30rpx;
  line-height: 1.5;
}

.main-input.content-input {
  height: 260rpx;
}

.field-hint {
  display: block;
  margin-top: 9rpx;
  color: #8a939c;
  font-size: 24rpx;
}

.config-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 14rpx;
}

.config-field {
  min-height: 108rpx;
  padding: 16rpx;
  border: 1rpx solid #e0e5e9;
  border-radius: 12rpx;
  background: #fafbfc;
}

.config-label,
.summary-label {
  display: block;
  color: #89929b;
  font-size: 21rpx;
  font-weight: 800;
}

.config-value,
.summary-value {
  display: block;
  overflow: hidden;
  margin-top: 8rpx;
  color: #252c33;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.option-toggle {
  display: flex;
  gap: 10rpx;
  align-items: center;
  justify-content: flex-start;
  height: 78rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dce2e6;
  border-radius: 12rpx;
  background: #ffffff;
  color: #69737d;
  font-size: 26rpx;
  font-weight: 800;
}

.option-toggle.on {
  border-color: #a8cec5;
  background: #eef7f4;
  color: #176b5b;
}

.option-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 1rpx solid #c8d0d6;
  border-radius: 6rpx;
  color: #176b5b;
  font-size: 22rpx;
}

.option-toggle.on .option-check {
  border-color: #78ad9f;
  background: #ffffff;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 94rpx;
  margin-top: 28rpx;
  border-radius: 12rpx;
  background: #a9342c;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.primary-action[disabled] {
  background: #89aea5;
  color: #ffffff;
}

.primary-action.compact {
  height: 74rpx;
  margin-top: 18rpx;
  font-size: 25rpx;
}

.error {
  display: block;
  margin-top: 14rpx;
  color: #bd3f2d;
  font-size: 23rpx;
  line-height: 1.45;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.quick-action {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 150rpx;
  padding: 20rpx;
  border: 1rpx solid #e0e5e9;
  border-radius: 12rpx;
  background: #ffffff;
  text-align: left;
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 8rpx;
  background: #f6e6e2;
  color: #a9342c;
  font-size: 21rpx;
  font-weight: 900;
}

.quick-title {
  margin-top: 16rpx;
  color: #252c33;
  font-size: 24rpx;
  font-weight: 900;
}

.quick-meta {
  margin-top: 6rpx;
  color: #89929b;
  font-size: 20rpx;
}

.result-toolbar {
  margin: 6rpx 0 18rpx;
}

.toolbar-actions {
  gap: 8rpx;
}

.score-hero {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
  padding: 26rpx;
  border-radius: 14rpx;
  background: #17232c;
  color: #ffffff;
}

.score-main {
  flex: 1;
  min-width: 0;
}

.score-line {
  display: flex;
  align-items: baseline;
  margin-top: 7rpx;
}

.score-number {
  font-size: 74rpx;
  font-weight: 900;
  line-height: 1;
}

.score-total {
  color: #9eabad;
  font-size: 24rpx;
  font-weight: 800;
}

.score-title,
.score-url {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-title {
  margin-top: 18rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.score-url {
  margin-top: 7rpx;
  color: #9eabad;
  font-size: 20rpx;
}

.score-change {
  display: flex;
  flex: 0 0 156rpx;
  flex-direction: column;
  justify-content: center;
  padding-left: 20rpx;
  border-left: 1rpx solid #34444a;
}

.change-label,
.change-target {
  color: #9eabad;
  font-size: 20rpx;
  font-weight: 700;
}

.change-value {
  margin: 7rpx 0;
  color: #f08b78;
  font-size: 42rpx;
  font-weight: 900;
}

.workflow-rail {
  width: 100%;
  margin-top: 14rpx;
}

.workflow-row {
  display: flex;
  gap: 8rpx;
  width: max-content;
  padding-bottom: 4rpx;
}

.workflow-step {
  display: flex;
  flex: 0 0 134rpx;
  flex-direction: column;
  gap: 5rpx;
  min-height: 82rpx;
  padding: 14rpx;
  border: 1rpx solid #e0e5e9;
  border-radius: 10rpx;
  background: #ffffff;
}

.workflow-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #bbc3c9;
}

.workflow-step.completed .workflow-dot,
.workflow-step.ready .workflow-dot {
  background: #2a937d;
}

.workflow-step.pending .workflow-dot {
  background: #d39b36;
}

.workflow-name {
  color: #252c33;
  font-size: 22rpx;
  font-weight: 900;
}

.workflow-status {
  color: #929ba3;
  font-size: 18rpx;
  font-weight: 700;
}

.loop-surface {
  border-color: #d5e2df;
  background: #fbfdfc;
}

.loop-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.loop-step {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 116rpx;
  padding: 14rpx;
  border: 1rpx solid #e1e6e9;
  border-radius: 10rpx;
  background: #ffffff;
  text-align: left;
}

.loop-step.done {
  border-color: #b9d8cf;
  background: #eef8f5;
}

.loop-step.current {
  border-color: #b83d32;
  background: #fff7f5;
}

.loop-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #edf1f3;
  color: #68737d;
  font-size: 17rpx;
  font-weight: 900;
}

.loop-step.done .loop-index {
  background: #2a937d;
  color: #ffffff;
}

.loop-step.current .loop-index {
  background: #b83d32;
  color: #ffffff;
}

.loop-name {
  margin-top: 10rpx;
  color: #222b32;
  font-size: 23rpx;
  font-weight: 900;
}

.loop-hint {
  margin-top: 5rpx;
  color: #7f8992;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
}

.loop-panel {
  border-color: #d7e4e0;
  background: #ffffff;
}

.publish-guide {
  margin: 12rpx 0;
  padding: 16rpx;
  border: 1rpx solid #eadbd7;
  border-radius: 10rpx;
  background: #fff8f6;
}

.publish-guide-title,
.publish-guide-copy {
  display: block;
}

.publish-guide-title {
  color: #a9342c;
  font-size: 21rpx;
  font-weight: 900;
}

.publish-guide-copy {
  margin-top: 7rpx;
  color: #5f6972;
  font-size: 22rpx;
  line-height: 1.45;
}

.section-head {
  gap: 14rpx;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  margin-top: 4rpx;
  color: #1d242b;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.section-tag {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #eef2f3;
  color: #64707a;
  font-size: 20rpx;
  font-weight: 800;
}

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx 20rpx;
}

.metric-name,
.metric-value {
  font-size: 21rpx;
  font-weight: 800;
}

.metric-name {
  color: #68737d;
}

.metric-value {
  color: #252c33;
}

.metric-track {
  overflow: hidden;
  height: 8rpx;
  margin-top: 9rpx;
  border-radius: 999rpx;
  background: #e8ecef;
}

.metric-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #b83d32;
}

.step-switcher {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.step-switch {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  align-items: flex-start;
  min-height: 96rpx;
  padding: 13rpx;
  border: 1rpx solid #e0e5e9;
  border-radius: 9rpx;
  background: #fafbfc;
  text-align: left;
}

.step-switch.active {
  border-color: #8ab9ae;
  background: #edf7f4;
}

.step-index {
  color: #176b5b;
  font-size: 19rpx;
  font-weight: 900;
}

.step-label {
  color: #39434c;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.3;
}

.active-step-panel {
  margin-top: 14rpx;
  padding: 20rpx;
  border: 1rpx solid #e0e5e9;
  border-radius: 10rpx;
  background: #fbfcfc;
}

.active-step-title,
.active-step-detail,
.step-note {
  display: block;
}

.active-step-title {
  font-size: 27rpx;
  font-weight: 900;
}

.active-step-detail,
.step-note {
  margin-top: 8rpx;
  color: #6e7882;
  font-size: 22rpx;
  line-height: 1.5;
}

.check-list {
  margin-top: 16rpx;
}

.check-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  padding: 11rpx 0;
  border-top: 1rpx solid #edf0f2;
}

.check-mark {
  display: flex;
  flex: 0 0 30rpx;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #e4f3ee;
  color: #176b5b;
  font-size: 18rpx;
  font-weight: 900;
}

.check-copy {
  flex: 1;
  min-width: 0;
  color: #414b54;
  font-size: 22rpx;
  line-height: 1.45;
}

.mini-actions,
.review-bar {
  display: flex;
  gap: 8rpx;
}

.mini-actions button {
  height: 48rpx;
  padding: 0 13rpx;
  border: 1rpx solid #d8dee3;
  border-radius: 8rpx;
  background: #ffffff;
  color: #52606a;
  font-size: 19rpx;
  font-weight: 800;
}

.result-tabs-scroll {
  width: 100%;
  margin-bottom: 20rpx;
}

.result-tabs {
  display: flex;
  gap: 8rpx;
  width: max-content;
  padding-bottom: 3rpx;
}

.result-tab {
  height: 54rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e0e5e9;
  border-radius: 9rpx;
  background: #ffffff;
  color: #69747d;
  font-size: 21rpx;
  font-weight: 800;
}

.result-tab.active {
  border-color: #8ab9ae;
  background: #edf7f4;
  color: #176b5b;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.summary-item {
  grid-column: 1 / -1;
  padding: 16rpx;
  border: 1rpx solid #e3e7ea;
  border-radius: 9rpx;
  background: #fbfcfd;
}

.summary-item.half {
  grid-column: auto;
}

.summary-value {
  white-space: normal;
}

.content-subtitle {
  margin-top: 24rpx;
}

.content-subtitle.first {
  margin-top: 0;
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.chip {
  max-width: 100%;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #edf0f2;
  color: #58636c;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.chip.green {
  background: #e8f4f0;
  color: #176b5b;
}

.chip.amber {
  background: #fff3df;
  color: #8a5d0a;
}

.issue-row,
.conversion-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  padding: 14rpx 0;
  border-top: 1rpx solid #edf0f2;
  color: #4a555e;
  font-size: 22rpx;
  line-height: 1.5;
}

.issue-row:first-of-type {
  margin-top: 8rpx;
}

.issue-mark,
.conversion-index {
  display: flex;
  flex: 0 0 30rpx;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #fff0e7;
  color: #a95628;
  font-size: 18rpx;
  font-weight: 900;
}

.module-card {
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #e0e5e9;
  border-radius: 10rpx;
  background: #fbfcfd;
}

.module-card:first-child {
  margin-top: 0;
}

.module-type,
.module-status {
  font-size: 19rpx;
  font-weight: 900;
  text-transform: uppercase;
}

.module-type {
  color: #176b5b;
}

.module-status {
  color: #8d969e;
}

.module-title-input,
.module-body-input {
  width: 100%;
  border: 1rpx solid #dce2e6;
  border-radius: 8rpx;
  background: #ffffff;
  color: #222a31;
}

.module-title-input {
  height: 66rpx;
  margin-top: 13rpx;
  padding: 0 14rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.module-body-input {
  min-height: 180rpx;
  margin-top: 10rpx;
  padding: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.module-meta-row {
  gap: 12rpx;
  margin-top: 12rpx;
  color: #89929b;
  font-size: 19rpx;
}

.review-bar {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin-top: 16rpx;
}

.review-bar button {
  height: 62rpx;
  border: 1rpx solid #d8dee3;
  border-radius: 8rpx;
  background: #ffffff;
  color: #55616b;
  font-size: 20rpx;
  font-weight: 900;
}

.review-bar button.approve {
  border-color: #82b5a8;
  background: #edf7f4;
  color: #176b5b;
}

.delivery-config {
  margin-top: 14rpx;
  padding: 14rpx;
  border: 1rpx solid #dfe5e8;
  border-radius: 9rpx;
  background: #f7f9fa;
}

.issue-list,
.status-stack,
.feedback-history {
  margin-top: 10rpx;
}

.delivery-title {
  color: #68737c;
  font-size: 19rpx;
  font-weight: 900;
}

.delivery-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  margin-top: 10rpx;
}

.delivery-switch button {
  height: 54rpx;
  border: 1rpx solid #d8dee3;
  border-radius: 8rpx;
  background: #ffffff;
  color: #68737c;
  font-size: 19rpx;
  font-weight: 900;
}

.delivery-switch button.active {
  border-color: #82b5a8;
  background: #e8f4f0;
  color: #176b5b;
}

.webhook-input {
  width: 100%;
  height: 62rpx;
  margin-top: 10rpx;
  padding: 0 13rpx;
  border: 1rpx solid #d8dee3;
  border-radius: 8rpx;
  background: #ffffff;
  color: #253039;
  font-size: 20rpx;
}

.status-note {
  margin-top: 10rpx;
  padding: 12rpx;
  border-radius: 8rpx;
  background: #f1f4f5;
  color: #56616a;
  font-size: 20rpx;
  font-weight: 800;
}

.schema-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 17rpx 0;
  border-top: 1rpx solid #edf0f2;
}

.schema-row:first-child {
  border-top: 0;
}

.schema-title,
.schema-meta {
  display: block;
}

.schema-title {
  font-size: 24rpx;
  font-weight: 900;
}

.schema-meta {
  margin-top: 5rpx;
  color: #8b949d;
  font-size: 19rpx;
}

.schema-status {
  padding: 7rpx 11rpx;
  border-radius: 999rpx;
  background: #fff3df;
  color: #8a5d0a;
  font-size: 19rpx;
  font-weight: 900;
}

.preview-copy {
  display: block;
  color: #69747d;
  font-size: 21rpx;
  line-height: 1.65;
}

.task-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  padding: 13rpx 0;
  border-top: 1rpx solid #edf0f2;
}

.task-copy {
  flex: 1;
  min-width: 0;
}

.task-title,
.task-url {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-title {
  font-size: 22rpx;
  font-weight: 900;
}

.task-url {
  margin-top: 4rpx;
  color: #8b949d;
  font-size: 18rpx;
}

.task-score {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e8f4f0;
  color: #176b5b;
  font-size: 20rpx;
  font-weight: 900;
}

.service-menu {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin: 20rpx 0;
  padding: 22rpx 14rpx;
  border: 1rpx solid #eadfda;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(68, 43, 37, 0.05);
}

.service-menu-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: center;
  color: #4c4541;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.25;
}

.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #cf5145, #8e241e);
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(154, 48, 39, 0.22);
}

.form-section.first {
  margin-top: 24rpx;
}

.client-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.business-input {
  width: 100%;
  height: 82rpx;
  padding: 0 18rpx;
  border: 1rpx solid #ded5d0;
  border-radius: 11rpx;
  background: #fcfaf9;
  color: #25211f;
  font-size: 27rpx;
  line-height: 82rpx;
}

.goal-input {
  margin-top: 12rpx;
}

.engine-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.engine-option {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 118rpx;
  padding: 18rpx;
  border: 1rpx solid #e2d9d5;
  border-radius: 12rpx;
  background: #fcfaf9;
  text-align: left;
}

.engine-option.selected {
  border-color: #c36a60;
  background: #f9ece9;
}

.engine-name,
.engine-note {
  display: block;
}

.engine-name {
  color: #302a27;
  font-size: 26rpx;
  font-weight: 900;
}

.engine-option.selected .engine-name {
  color: #9c3028;
}

.engine-note {
  margin-top: 6rpx;
  color: #8c817b;
  font-size: 21rpx;
  line-height: 1.35;
}

.visibility-surface {
  border-top: 8rpx solid #b83d32;
}

.visibility-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8rpx;
}

.visibility-metric {
  padding: 16rpx 10rpx;
  border-radius: 8rpx;
  background: #f6f2f0;
  text-align: center;
}

.visibility-value,
.visibility-label {
  display: block;
}

.visibility-value {
  color: #9c3028;
  font-size: 30rpx;
  font-weight: 900;
}

.visibility-label {
  margin-top: 4rpx;
  color: #827872;
  font-size: 18rpx;
  font-weight: 800;
}

.engine-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.engine-pill {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #17232c;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
  text-transform: capitalize;
}

.monitor-actions {
  margin-top: 12rpx;
}
