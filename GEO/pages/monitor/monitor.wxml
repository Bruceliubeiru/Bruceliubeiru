      <view>
        <text class="item-title">{{item.title}}</text>
        <text class="item-meta">{{item.index_status}} · {{item.public_url || item.feishu_url || item.markdown_path}}</text>
        <text class="item-meta">飞书：{{item.feishu_status || 'not_synced'}} · {{item.last_feishu_sync_at || '未同步'}}</text>
        <text wx:if="{{item.indexing_notes}}" class="item-meta">备注：{{item.indexing_notes}}</text>
        <text wx:if="{{item.error}}" class="item-meta">错误：{{item.error}}</text>
      </view>
      <view class="action-stack column">
        <button class="pill-button" loading="{{savingSection === ('article-feishu-' + item.article_id)}}" data-article-id="{{item.article_id}}" bindtap="syncArticleFeishu">同步飞书</button>
        <button class="pill-button" data-article-id="{{item.article_id}}" data-status="published" data-public-url="{{item.public_url || ''}}" bindtap="updateArticleStatus">已发布</button>
        <button class="pill-button" data-article-id="{{item.article_id}}" data-status="indexed" data-public-url="{{item.public_url || ''}}" bindtap="updateArticleStatus">已收录</button>
        <button class="pill-button" data-article-id="{{item.article_id}}" data-status="ai_cited" data-public-url="{{item.public_url || ''}}" bindtap="updateArticleStatus">AI 已引用</button>
        <button class="pill-button" loading="{{loadingChecklistFor === item.article_id}}" data-article-id="{{item.article_id}}" bindtap="copyChecklist">收录清单</button>
      </view>
    </view>
    <view wx:if="{{recentArticleEvents.length}}" class="checklist-box top-gap">
      <text class="item-title">最近收录轨迹</text>
      <text class="item-meta multiline" wx:for="{{recentArticleEvents}}" wx:key="event_id" wx:for-item="item">{{item.index_status}} · {{item.public_url || '未填 URL'}} · {{item.notes || '无备注'}} · {{item.created_at}}</text>
    </view>
    <view wx:if="{{publicationEvents.length}}" class="checklist-box top-gap">
      <text class="item-title">最近发布轨迹</text>
      <view class="list-card mini-card" wx:for="{{publicationEvents}}" wx:key="event_id" wx:for-item="item">
        <view>
          <text class="item-title">{{item.status}}</text>
          <text class="item-meta">{{item.notes || '无备注'}}</text>
        </view>
        <text class="status">{{item.created_at}}</text>
      </view>
    </view>
    <view class="list-card" wx:for="{{publications}}" wx:key="publication_id" wx:for-item="item">
      <view>
        <text class="item-title">{{item.preview.target_name || item.target_id}}</text>
        <text class="item-meta">{{item.status}} · 线上 {{item.live_status || 'pending'}} · 回滚 {{item.rollback_status || 'none'}}</text>
        <text wx:if="{{item.preview && item.preview.modules && item.preview.modules.length}}" class="item-meta">预览模块：{{item.preview.modules.length}} 个</text>
        <text wx:if="{{item.response_summary}}" class="item-meta">{{item.response_summary}}</text>
      </view>
      <view class="action-stack column">
        <button wx:if="{{item.status === 'pending_confirmation'}}" class="pill-button" loading="{{savingSection === ('publication-' + item.publication_id + '-confirm')}}" data-publication-id="{{item.publication_id}}" bindtap="confirmPendingPublication">确认发布</button>
        <button wx:if="{{item.status === 'failed'}}" class="pill-button" loading="{{savingSection === ('publication-' + item.publication_id + '-retry')}}" data-publication-id="{{item.publication_id}}" data-action="retry" bindtap="quickPublicationAction">重试</button>
        <button wx:if="{{item.status === 'published' || item.status === 'verification_failed'}}" class="pill-button" loading="{{savingSection === ('publication-' + item.publication_id + '-verify')}}" data-publication-id="{{item.publication_id}}" data-action="verify" bindtap="quickPublicationAction">校验</button>
        <button wx:if="{{item.status === 'published' || item.status === 'verification_failed'}}" class="pill-button" loading="{{savingSection === ('publication-' + item.publication_id + '-schedule_verify')}}" data-publication-id="{{item.publication_id}}" data-action="schedule_verify" bindtap="quickPublicationAction">排队校验</button>
        <button wx:if="{{item.status === 'published' || item.status === 'verification_failed' || item.status === 'verified_live'}}" class="pill-button" loading="{{savingSection === ('publication-' + item.publication_id + '-rollback')}}" data-publication-id="{{item.publication_id}}" data-action="rollback" bindtap="quickPublicationAction">已回滚</button>
      </view>
    </view>
    <view wx:if="{{articleChecklist}}" class="checklist-box">
      <text class="item-title">最近复制的收录清单</text>
      <text class="item-meta multiline">{{articleChecklist}}</text>
    </view>
  </view>

  <view class="surface" wx:if="{{mentionChecks.length}}">
    <view class="section-head">
      <text class="section-title">最近采样</text>
      <text class="section-tag">{{mentionChecks.length}} 条</text>
    </view>
    <view class="list-card" wx:for="{{mentionChecks}}" wx:key="check_id" wx:for-item="check">
      <view>
        <text class="item-title">{{check.engine}} · {{check.brand_mentioned ? '已提及' : '未提及'}}</text>
        <text class="item-meta">位置 {{check.mention_position || '-'}} · {{check.source_type || 'unknown'}}</text>
        <text wx:if="{{check.answer_excerpt}}" class="item-meta">{{check.answer_excerpt}}</text>
      </view>
      <text class="status">{{check.cited_our_domain ? '已引用官网' : '未引用官网'}}</text>
    </view>
  </view>
</view>
